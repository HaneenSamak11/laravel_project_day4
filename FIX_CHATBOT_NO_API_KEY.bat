@echo off
setlocal
cd /d "%~dp0"
title Fix Laravel Chatbot - No API Key Needed

echo ==============================================
echo  Fixing chatbot to work without OpenAI API key
echo ==============================================
echo.

if not exist artisan (
    echo [ERROR] Put this file inside the Laravel project folder.
    echo It must be beside the artisan file.
    pause
    exit /b 1
)

if not exist app\Services mkdir app\Services

powershell -NoProfile -ExecutionPolicy Bypass -Command "[IO.File]::WriteAllBytes('app\Services\OpenAIDataChatbot.php',[Convert]::FromBase64String(''))"
if errorlevel 1 goto :failed

powershell -NoProfile -Command "(Get-Content 'config\database.php') -replace 'PDO::ATTR_SSL_CA','PDO::MYSQL_ATTR_SSL_CA' | Set-Content 'config\database.php'"

php artisan optimize:clear
if errorlevel 1 goto :failed

echo.
echo ==============================================
echo  DONE - Chatbot now works without an API key.
echo  Refresh the chatbot page and try again.
echo ==============================================
pause
exit /b 0

:failed
echo.
echo [ERROR] The fix could not be completed.
echo Make sure this BAT file is inside the project folder.
pause
exit /b 1
